{
  "name": "blog-in-a-box",
  "version": "1.0.10",
  "description": "Blog In A Box",
  "main": "app/index.js",
  "repository": "https://github.com/Automattic/biab-installer",
  "keywords": [
    "raspberry pi",
    "raspbian",
    "wordpress",
    "wordpress.com"
  ],
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "start": "NODE_ENV=development DEBUG=tinker* webpack-dev-server --progress --colors --content-base=./app --config ./webpack.dev.config.js --port 3312 --host 0.0.0.0",
    "build-web": "NODE_ENV=production webpack --progress --colors --config ./webpack.web.config.js",
    "dev": "NODE_ENV=development electron ./app",
    "app": "NODE_ENV=production electron ./app",
    "dmg": "tiffutil -cathidpicheck build/dmg/background@1x.png build/dmg/background@2x.png -out build/dmg/background.png",
    "pack": "build --dir -mwl",
    "dist": "build -mwl",
    "release": "node ./check.js && yarn run build-web && build --mac --win --linux -p always",
    "postinstall": "cd app; yarn install --ignore-platform"
  },
  "author": "Automattic",
  "devDependencies": {
    "autoprefixer": "^6.7.4",
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.4",
    "@babel/plugin-transform-async-to-generator": "^7.29.7",
    "@babel/plugin-transform-flow-strip-types": "^7.29.7",
    "@babel/plugin-transform-object-rest-spread": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "babel-loader": "^8.4.1",
    "chai": "^3.5.0",
    "css-loader": "^0.28.11",
    "devtron": "^1.4.0",
    "electron": "^39.8.5",
    "electron-builder": "^20.44.4",
    "electron-debug": "^1.1.0",
    "electron-devtools-installer": "^2.1.0",
    "electron-rebuild": "^2.3.5",
    "eslint": "^7.32.0",
    "eslint-config-wpcalypso": "^0.6.0",
    "eslint-plugin-flowtype": "^2.30.0",
    "eslint-plugin-react": "^6.10.0",
    "eslint-plugin-wpcalypso": "^3.0.2",
    "json-loader": "^0.5.4",
    "lodash.noop": "^3.0.1",
    "mocha": "^3.2.0",
    "node-sass": "^4.14.1",
    "postcss-cssnext": "^3.1.1",
    "postcss-focus": "^1.0.0",
    "postcss-loader": "^2.1.6",
    "postcss-reporter": "^3.0.0",
    "react-hot-loader": "^4.13.1",
    "redux-devtools-extension": "^2.13.0",
    "sass-loader": "^6.0.7",
    "style-loader": "^0.23.1",
    "webpack": "^2.2.1",
    "webpack-dev-server": "^2.4.1",
    "webpack-merge": "^3.0.0",
    "webpack-remove-debug": "^0.1.0"
  },
  "dependencies": {
    "child_process": "^1.0.2",
    "classnames": "^2.2.5",
    "debug": "^2.6.1",
    "drivelist": "^5.0.11",
    "electron-is-running-in-asar": "^1.0.0",
    "electron-log": "^1.3.0",
    "electron-updater": "^1.7.1",
    "etcher-image-stream": "^5.1.0",
    "etcher-image-write": "^9.0.0",
    "generate-password": "^1.3.0",
    "humanize-duration": "^3.10.0",
    "is-elevated": "^1.0.0",
    "lodash": "^4.17.21",
    "moment-timezone": "^0.5.11",
    "ncp": "^2.0.0",
    "node-ipc": "^8.10.3",
    "prettysize": "^0.0.3",
    "react": "^15.4.2",
    "react-dom": "^15.4.2",
    "react-redux": "^5.0.2",
    "redux": "^3.6.0",
    "redux-thunk": "^2.2.0",
    "removedrive": "^1.1.1",
    "resin-cli-form": "^1.4.1",
    "resin-cli-visuals": "^1.3.0",
    "sudo-prompt": "https://github.com/tinkertinker/sudo-prompt.git",
    "yargs": "^6.6.0"
  },
  "resolutions": {
    "cipher-base": "^1.0.5",
    "deep-extend": "^0.5.1",
    "elliptic": "^6.6.1",
    "ejs": "^3.1.10",
    "eventsource": "^1.1.1",
    "fsevents": "^1.2.13",
    "form-data": "^2.5.4",
    "growl": "^1.10.0",
    "json-schema": "^0.4.0",
    "loader-utils": "^1.4.2",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "macaddress": "^0.2.9",
    "minimist": "^1.2.8",
    "pbkdf2": "^3.1.3",
    "plist": "^3.1.0",
    "sha.js": "^2.4.12",
    "thenify": "^3.3.1",
    "underscore": "^1.13.7",
    "url-parse": "^1.5.10"
  },
  "eslintConfig": {
    "env": {
      "mocha": true,
      "node": true
    },
    "extends": [
      "wpcalypso/react",
      "plugin:flowtype/recommended"
    ],
    "plugins": [
      "flowtype"
    ],
    "rules": {
      "max-len": 0,
      "wpcalypso/jsx-classname-namespace": 0
    },
    "parserOptions": {
      "ecmaFeatures": {
        "experimentalObjectRestSpread": true
      }
    }
  },
  "build": {
    "appId": "com.automattic.biab",
    "productName": "Blog In A Box",
    "copyright": "Automattic",
    "dmg": {
      "icon": "build/dmg/icon.icns",
      "background": "build/dmg/background.png",
      "iconSize": "150",
      "title": "${productName}",
      "contents": [
        {
          "x": 156,
          "y": 179
        },
        {
          "x": 486,
          "y": 176,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "category": "Development",
      "icon": "icons/",
	  "target": [ "deb", "tar.gz" ],
	  "maintainer": "WordPress.com Support <support@wordpress.com>"
    },
    "mac": {
      "category": "public.app-category.developer-tools"
    },
    "nsis": {
      "license": "LICENSE"
    },
    "extraFiles": [
      {
        "from": "app/node_modules/drivelist/scripts",
        "to": "Resources/scripts"
      }
    ]
  }
}
